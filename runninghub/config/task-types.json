    {
      "typeId": "voice-clone-emo",
      "version": 1,
      "displayName": "IndexTTS2 音色克隆（带语气）",
      "description": "输入要朗读的文字和一段参考人声（几秒以上、尽量干净无背景音），生成用该音色说话的音频。还可以再给一段带情绪的人声，让朗读带上同样的语气（开心、温柔、激动等）；情绪音频留空时使用工作流自带的默认语气。",
      "workflowId": "2103675587473788929",
      "instanceType": "default",
      "params": [
        {
          "name": "text",
          "label": "语音文字",
          "type": "text",
          "required": true,
          "nodeId": "14",
          "fieldName": "value"
        },
        {
          "name": "referenceAudio",
          "label": "参考人声（音色来源）",
          "type": "audio",
          "required": false,
          "nodeId": "13",
          "fieldName": "audio",
          "accept": [".mp3", ".wav", ".m4a", ".m3a"]
        },
        {
          "name": "emotionAudio",
          "label": "情绪参考音频",
          "type": "audio",
          "required": false,
          "nodeId": "15",
          "fieldName": "audio",
          "accept": [".mp3", ".wav", ".m4a", ".m3a"]
        }
      ],
      "fixedOverrides": []
    },
    {
      "typeId": "digital-human",
      "version": 1,
      "displayName": "数字人生成",
      "description": "一张人物正面照 + 一段参考人声（只提取音色，不需要是成品配音）+ 要播报的文案：先用参考音色把文案合成为语音，再驱动照片里的人物对口型说话，生成口播数字人视频。",
